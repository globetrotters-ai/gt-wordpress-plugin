{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/wp-env.json",
	"core": "WordPress/WordPress#7.0",
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"AUTOMATIC_UPDATER_DISABLED": true,
		"WP_AUTO_UPDATE_CORE": false
	},
	"mappings": {
		"wp-content/plugins/globetrotters-ai-presence": "."
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin activate globetrotters-ai-presence && wp-env run tests-cli wp plugin activate globetrotters-ai-presence"
	},
	"env": {
		"development": {
			"plugins": [
				"https://downloads.wordpress.org/plugin/plugin-check.zip"
			]
		},
		"tests": {
			"plugins": [
				"https://downloads.wordpress.org/plugin/wordfence.zip",
				"https://downloads.wordpress.org/plugin/wp-super-cache.zip"
			]
		}
	}
}
